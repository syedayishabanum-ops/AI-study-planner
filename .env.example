# Server Port Configuration
PORT=5000

# Authentication & Database fallback mode
JWT_SECRET=your_jwt_secret_key_here_for_local_fallback

# Supabase Credentials (Optional: if empty, server uses server/data/local_db.json)
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_key

# Gemini API Configuration (Optional: if empty, server runs mock AI responses)
GEMINI_API_KEY=your_gemini_api_key


# Frontend Configuration
VITE_API_URL=http://localhost:5000/api

